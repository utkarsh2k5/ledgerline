# Copy to backend/.env and edit. Every value has a safe default for local use.

# SQLite by default; Docker Compose uses Postgres:
# DATABASE_URL=postgresql+psycopg://ledgerline:ledgerline@localhost:5432/ledgerline
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes

# AI commentary: "mock" (offline, deterministic), "gemini", or "mock-hallucinate" (demo of the fact-checker)
AI_PROVIDER=mock
GEMINI_API_KEY=
# Defaults to Google's rolling Flash alias; pin a specific model if you prefer
GEMINI_MODEL=gemini-flash-latest
# Backup models tried when the main one is overloaded (HTTP 503) or out of free quota (429)
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest

# Reconciliation thresholds (basis points)
RECON_TOLERANCE_BPS=5
MATERIAL_BREAK_BPS=25

# Run the job worker inside the API process (set false when running a separate worker)
EMBEDDED_WORKER=true

# One-click role access on the start page (no passwords). Set false for real use.
DEMO_MODE=true
